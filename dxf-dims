#!/usr/bin/env python3
"""
Mede DXF: largura × altura da caixa envolvente do desenho, em mm.

É a escala da miniatura. O viewer do Diosef escrevia "L: 280.0mm | A: 32.5mm"
embaixo de cada desenho, e era pelo tamanho que ele achava a lâmina na pilha;
o tablet da fábrica precisa do mesmo número.

Em lote para não pagar a importação do ezdxf por arquivo: lê caminhos de DXF
do stdin, um por linha (UTF-8), e escreve no stdout uma linha JSON por arquivo,
na mesma ordem:

  {"path": "...", "widthMm": 281.4, "heightMm": 32.5}
  {"path": "...", "error": "..."}

Desenho vazio ou ilegível vira "error" e o lote segue. Unidade: $INSUNITS do
arquivo (polegada, cm e m convertidos); sem unidade declarada, mm — é como
CypCut e AlmaCAM gravam.

Uso:
  dxf-dims < lista.txt
"""

import json
import sys

import ezdxf
from ezdxf import bbox

# $INSUNITS → fator para mm. 0 (sem unidade) e 4 (mm) ficam 1.
TO_MM = {1: 25.4, 2: 304.8, 5: 10.0, 6: 1000.0}


def _layout(doc):
    """O mesmo critério do dxf-thumb: model space; se vazio, o maior paperspace."""
    msp = doc.modelspace()
    if len(msp) > 0:
        return msp
    best = None
    for layout in doc.layouts:
        if layout.is_modelspace:
            continue
        if best is None or len(layout) > len(best):
            best = layout
    return best or msp


def measure(path: str) -> dict:
    doc = ezdxf.readfile(path)
    box = bbox.extents(_layout(doc), fast=False)
    if not box.has_data:
        return {"path": path, "error": "desenho vazio"}
    factor = TO_MM.get(int(doc.header.get("$INSUNITS", 0) or 0), 1.0)
    w, h = box.size.x * factor, box.size.y * factor
    if w <= 0 and h <= 0:
        return {"path": path, "error": "desenho vazio"}
    return {"path": path, "widthMm": round(w, 1), "heightMm": round(h, 1)}


def main() -> int:
    stdin = open(sys.stdin.fileno(), encoding="utf-8", errors="replace", closefd=False)
    out = open(sys.stdout.fileno(), "w", encoding="utf-8", closefd=False)
    for line in stdin:
        path = line.rstrip("\r\n")
        if not path:
            continue
        try:
            result = measure(path)
        except Exception as e:  # DXF inválido não derruba o lote
            result = {"path": path, "error": str(e)[:200]}
        out.write(json.dumps(result, ensure_ascii=False) + "\n")
        out.flush()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
